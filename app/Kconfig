mainmenu "WildSonic STM32 mono recorder"

menu "Audio recorder"

config AUDIO_SRC_ADC_STM32L4
	bool "STM32L4 internal ADC: TIM6 trigger + hardware oversampling + DMA"
	default y
	depends on SOC_SERIES_STM32L4X
	select DMA
	select PINCTRL
	select USE_STM32_LL_ADC
	select USE_STM32_LL_TIM

choice AUDIO_SAMPLE_FORMAT
	prompt "Audio sample format"
	default AUDIO_SAMPLE_BITS_16

config AUDIO_SAMPLE_BITS_16
	bool "16-bit signed integer PCM (Format Tag 1)"
	help
	  Standard 16-bit signed integer PCM (2 bytes/sample). Baseline profile.
	  At 192 kHz mono, data rate is 384,000 bytes/s.

config AUDIO_SAMPLE_BITS_32
	bool "32-bit signed integer PCM (Format Tag 1)"
	help
	  32-bit signed integer PCM (4 bytes/sample).
	  At 192 kHz mono, data rate is 768,000 bytes/s.
	  Acquisition uses STM32L4 ADC (12-bit + 8x hardware oversampling = 15-bit ENOB)
	  left-aligned into signed 32-bit integer container.
endchoice

config AUDIO_SAMPLE_BITS
	int
	default 16 if AUDIO_SAMPLE_BITS_16
	default 32 if AUDIO_SAMPLE_BITS_32

config AUDIO_SAMPLE_RATE
	int "Requested sample rate (Hz)"
	default 48000
	help
	  Requested audio sample rate in Hz.
	  Default is 192,000 samples/s as required for stress testing the STM32L476
	  acquisition and storage throughput. At 192 kHz mono 16-bit PCM, the data
	  rate is 384,000 bytes/s. A 60-second WAV file contains exactly 11,520,000
	  samples (23,040,000 audio data bytes).
	  NOTE: The MAX4466 capsule frequency response is ~20 Hz to 20 kHz (audible
	  range). Sampling at 192 kHz oversamples the audible analog bandwidth.

config AUDIO_BLOCK_SAMPLES
	int "Samples per block (one DMA half-buffer / one queue item)"
	default 4096
	help
	  Block size in samples.
	  For 16-bit mono: 4096 samples * 2 bytes = 8192 bytes (16 SD sectors).
	  For 32-bit mono: 4096 samples * 4 bytes = 16384 bytes (32 SD sectors).
	  At 192 kHz, 11,520,000 samples / 4096 = exactly 2812.5 blocks for a 60-second file.

config AUDIO_NUM_BLOCKS
	int "Number of blocks in the RAM pool (the SD-stall buffer)"
	default 4 if AUDIO_SAMPLE_BITS_16
	default 2 if AUDIO_SAMPLE_BITS_32
	help
	  Buffered time = NUM_BLOCKS * BLOCK_SAMPLES / sample_rate.
	  With 4 blocks of 4096 samples at 16-bit: 32 KB pool, 85.3 ms buffer.
	  With 2 blocks of 4096 samples at 32-bit: 32 KB pool, 42.7 ms buffer.
	  Both safely fit within the 96 KB SRAM1 region without overflowing.

config AUDIO_OVERSAMPLE_LOG2
	int "ADC hardware oversampling, log2 of ratio (0 = off, 4 = 16x)"
	range 0 4
	default 3
	depends on AUDIO_SRC_ADC_STM32L4
	help
	  Hardware oversampling on STM32L4 ADC. Ratio = 2^N.
	  At 192 kHz, 8x oversampling (default 3) fits in 37.4% of the 5.2 us period.

config AUDIO_DC_BLOCK
	bool "Remove DC offset (MAX4466 output sits at VCC/2)"
	default y
	depends on AUDIO_SRC_ADC_STM32L4
	help
	  High-pass DC blocking filter: y[n] = x[n] - x[n-1] + y[n-1]*(1 - 2^-K).
	  At 192 kHz with K=10, the cutoff is ~30 Hz, safely removing the DC bias
	  without attenuating audio frequencies.

menu "DSP Noise Reduction Pipeline"

choice AUDIO_DSP_MODE
	prompt "Audio DSP Processing Pipeline Mode"
	default AUDIO_DSP_MODE_FILTERED

config AUDIO_DSP_MODE_RAW
	bool "Raw (unfiltered ADC PCM, bypasses DSP)"
	help
	  Records verbatim ADC readings with only linear scaling to signed PCM.
	  No filtering is applied. Ideal for baseline comparison, raw noise analysis,
	  and assessing hardware analog environment.

config AUDIO_DSP_MODE_FILTERED
	bool "Filtered (multi-stage low-noise DSP pipeline)"
	help
	  Enables the configurable low-noise DSP processing chain (DC blocker,
	  high-pass filter, mains notch filter, and ultrasonic low-pass filter).

endchoice

config AUDIO_DSP_DC_BLOCK
	bool "Stage 1: DC Blocker (high-pass tracking, 20 Hz)"
	default y
	help
	  Removes MAX4466 DC bias (~1.65V) and slow DC drift (< 20 Hz).

config AUDIO_DSP_HPF
	bool "Stage 2: High-Pass Filter (Butterworth HPF)"
	default y
	help
	  2nd-order Butterworth High-Pass Filter to eliminate sub-audible wind,
	  handling rumble, and sub-audio vibrations.

config AUDIO_DSP_HPF_CUTOFF_HZ
	int "HPF Cutoff Frequency (Hz)"
	default 80
	depends on AUDIO_DSP_HPF
	help
	  Cutoff frequency (-3 dB point) for the HPF stage.
	  Default 80 Hz is optimal for wildlife/voice audio; lower values (e.g. 30-50 Hz)
	  can be set if low-frequency vocalizations must be retained.

config AUDIO_DSP_NOTCH
	bool "Stage 3: Mains Hum Notch Filter"
	default n
	help
	  Narrow-band biquad notch filter to eliminate 50 Hz or 60 Hz mains interference.
	  Kept disabled by default until measured interference is confirmed.

config AUDIO_DSP_NOTCH_FREQ_HZ
	int "Mains Notch Frequency (Hz)"
	default 50
	depends on AUDIO_DSP_NOTCH
	help
	  Target notch frequency: 50 Hz (Europe/Asia) or 60 Hz (Americas).

config AUDIO_DSP_NOTCH_Q_X10
	int "Mains Notch Q factor (multiplied by 10)"
	default 100
	depends on AUDIO_DSP_NOTCH
	help
	  Quality factor Q * 10 (e.g. 100 = Q of 10.0, 150 = Q of 15.0).
	  Higher Q narrows the notch bandwidth, preserving nearby frequencies.

config AUDIO_DSP_HARMONIC_NOTCH
	bool "Stage 4: Mains Harmonic Notch Filter (2nd harmonic)"
	default n
	depends on AUDIO_DSP_NOTCH
	help
	  Narrow-band notch at 2x mains frequency (100 Hz or 120 Hz) to suppress
	  rectifier/power supply ripple.

config AUDIO_DSP_LPF
	bool "Stage 5: Low-Pass Anti-Aliasing & Ultrasonic Rejection Filter"
	default y
	help
	  4th-order (2 cascaded biquads) Butterworth Low-Pass Filter to eliminate
	  out-of-band switching noise, SDMMC digital crosstalk, and ultrasonic hash
	  beyond the MAX4466 microphone's ~20 kHz audible bandwidth.

config AUDIO_DSP_LPF_CUTOFF_HZ
	int "LPF Cutoff Frequency (Hz)"
	default 20000
	depends on AUDIO_DSP_LPF
	help
	  Passband corner frequency (-3 dB point). Default 20000 Hz.

endmenu

config AUDIO_RECORD_SECONDS
	int "Seconds to record per session"
	default 20

config AUDIO_SLEEP_SECONDS
	int "Seconds to sleep between recording sessions"
	default 60

config AUDIO_RECORD_CYCLES
	int "Number of record/sleep cycles (0 = continuous until stopped)"
	default 1

config AUDIO_PREALLOCATE_FILE
	bool "Pre-allocate audio file clusters prior to recording"
	default y
	help
	  When enabled (and if CONFIG_FS_FATFS_EXTRA_NATIVE_API is active),
	  calls FatFs f_expand() to pre-allocate contiguous clusters on exFAT,
	  preventing dynamic cluster allocation stalls during recording.

config WILDSONIC_SDMMC_CLK_DIV
	int "SDMMC clock divider"
	default 4
	range 0 16
	help
	  Clock divider for SDMMC1 on STM32L4 (48 MHz / (clk_div + 2)).
	  clk_div = 0: 24 MHz (12 MB/s bus bandwidth, high-speed production)
	  clk_div = 2: 12 MHz (6 MB/s bus bandwidth, high-speed)
	  clk_div = 4: 8 MHz (4 MB/s bus bandwidth, confirmed baseline)
	  clk_div = 6: 6 MHz (3 MB/s bus bandwidth, safe jumper-wire default)

config PSRAM_TEST_ENABLE
    bool "Run external ISSI IS66WVS4M8 PSRAM detection and memory test on boot"
    default y
    select USE_STM32_HAL_QSPI
    select USE_STM32_HAL_DMA
    help
      Initializes the QUADSPI peripheral and executes the bring-up and
      memory verification test for the ISSI IS66WVS4M8 PSRAM. If not detected,
      safely falls back to internal SRAM.

config AUDIO_PSRAM_STAGING
	bool "Use external ISSI IS66WVS PSRAM as circular audio staging buffer"
	default y
	depends on PSRAM_TEST_ENABLE
	help
	  Buffers processed PCM audio blocks in external PSRAM before writing
	  to the SD card in large multi-block batches. Decouples SD write latency
	  from the high-speed ADC/DMA capture path.

config AUDIO_PSRAM_BUFFER_SIZE_KB
	int "PSRAM staging buffer size in KiB"
	default 3072
	range 256 3072
	depends on AUDIO_PSRAM_STAGING
	help
	  Size of circular buffer in external PSRAM in KiB.
	  Default is 3072 KiB (3 MiB, 12 slots x 256 KiB, 75% of physical 4 MB PSRAM),
	  providing ~8.19 seconds of buffer at 192 kHz 16-bit mono and ~32.76 seconds at 48 kHz.
	  1024 KiB (1 MiB, 25%) is reserved for diagnostics and safety.

config AUDIO_SD_BATCH_SIZE_KB
	int "SD card write batch size in KiB"
	default 256
	range 32 1024
	depends on AUDIO_PSRAM_STAGING
	help
	  Size of multi-block SD card write batch in KiB. Must be a multiple of 4 KiB
	  and aligned to 512-byte sectors. Default is 256 KiB (512 sectors).

config AUDIO_SD_IO_CHUNK_KB
	int "SD storage I/O chunk size in KiB"
	default 16
	range 8 64
	depends on AUDIO_PSRAM_STAGING
	help
	  Filesystem I/O chunk size in KiB for SD card writes. Independent of the
	  audio block size (4096 samples = 8 KiB) and PSRAM slot size (256 KiB).
	  Configuring 16 or 32 KiB reduces SD card CMD12/CMD25 transactions and
	  flash write programming delays.

choice AUDIO_STORAGE_PIPELINE
	prompt "Audio Storage Pipeline Mode"
	default AUDIO_STORAGE_PIPELINE_PSRAM_SYNC
	depends on AUDIO_PSRAM_STAGING
	help
	  Select the storage pipeline architecture for draining PSRAM staging to SD card.

config AUDIO_STORAGE_PIPELINE_PSRAM_SYNC
	bool "Mode B: Synchronous PSRAM Read and SD Write (Production Default)"
	help
	  Performs sequential PSRAM read to internal SRAM bounce buffer followed by SDMMC write.
	  Ensures zero bus contention and zero interrupt jitter between Quad-SPI polling and
	  SDMMC interrupt-driven transfers, completely preventing SDMMC FIFO underruns.

config AUDIO_STORAGE_PIPELINE_PSRAM_ASYNC
	bool "Mode C: Asynchronous Ping-Pong PSRAM Staging"
	help
	  Uses dual SRAM ping-pong buffers with separate reader and writer threads.
endchoice

endmenu

menu "SD card formatter"

choice FORMAT_CARD_PROFILE
	prompt "Target SD card capacity profile for safety check"
	default FORMAT_CARD_32GB

config FORMAT_CARD_32GB
	bool "32 GB card profile (62,333,952 sectors x 512 bytes = ~31.9 GB)"
	help
	  Matches standard 32 GB microSD cards (such as SanDisk Ultra/Extreme 32 GB).
	  Expected sector count: 62,333,952 sectors (31,914,983,424 bytes).

config FORMAT_CARD_64GB
	bool "64 GB card profile (124,735,488 sectors x 512 bytes = ~63.9 GB)"
	help
	  Matches standard 64 GB microSDXC cards.
	  Expected sector count: 124,735,488 sectors (63,864,569,856 bytes).

config FORMAT_CARD_CUSTOM
	bool "Custom card capacity profile"
	help
	  Specify exact sector count manually via FORMAT_CUSTOM_SECTOR_COUNT.

endchoice

config FORMAT_EXPECTED_SECTOR_COUNT
	int "Expected sector count for safety validation"
	default 62333952 if FORMAT_CARD_32GB
	default 124735488 if FORMAT_CARD_64GB
	default 62333952 if FORMAT_CARD_CUSTOM

config FORMAT_CUSTOM_SECTOR_COUNT
	int "Custom expected sector count"
	default 62333952
	depends on FORMAT_CARD_CUSTOM

config FORMAT_EXPECTED_SECTOR_SIZE
	int "Expected sector size (bytes)"
	default 512

endmenu

config WILDSONIC_VERBOSE_LOGS
	bool "Enable verbose development and diagnostic console logs"
	default n
	help
	  When disabled (default for production firmware), console output is kept
	  minimal and quiet, suppressing startup banners, detailed PSRAM bring-up
	  matrices, per-session banners, and standby countdown messages.
	  Enable this symbol for test and engineering builds.

config LOG_DEFAULT_LEVEL_WRN
	bool "Default log level WARNING"
	default n
	help
	  Sets default logging level to WARNING (2).

config LOG_DEFAULT_LEVEL_INF
	bool "Default log level INFO"
	default n
	help
	  Sets default logging level to INFO (3).

# SD over SPI must use DMA (see sd/spi_*.overlay). Only takes effect when SPI is in use.
config SPI_STM32_DMA
	default y

source "Kconfig.zephyr"

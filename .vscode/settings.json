{
    "cmake.sourceDirectory": "${workspaceFolder}/app",
    "terminal.integrated.stickyScroll.enabled": false,
    "zephyr-workbench.build.configurations": [
      {
        "name": "PRODUCTION",
        "board": "nucleo_l476rg",
        "active": "true",
        "west-flags": [
          "SD_BUS=sdmmc"
        ],
        "default-runner": "stm32cubeprogrammer"
      },
      {
        "name": "TEST",
        "board": "nucleo_l476rg",
        "west-flags": [
          "SD_BUS=sdmmc",
          "EXTRA_CONF_FILE=test.conf"
        ],
        "env.EXTRA_CONF_FILE": [
          "${workspaceFolder}/app/test.conf"
        ],
        "default-runner": "stm32cubeprogrammer"
      },
      {
        "name": "primary",
        "board": "nucleo_l476rg",
        "west-flags": [
          "SD_BUS=sdmmc"
        ],
        "default-runner": "stm32cubeprogrammer"
      }
    ],
    "zephyr-workbench.westWorkspace": "${workspaceFolder}/../../zephyrproject-4.5.0-rc2",
    "zephyr-workbench.toolchain": "zephyr",
    "zephyr-workbench.sdk": "global",
    "zephyr-workbench.intellisense.provider": "cpptools"
}
